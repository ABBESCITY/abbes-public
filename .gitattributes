# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Explicitly specify the newline character for a particular text file.
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf

# Undo the GitHub's default
packages/**/*.d.ts -linguist-vendored